{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      }
    },
    "internal-test": {
      "distribution": "internal",
      "channel": "internal-test",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "internal-test-ios": {
      "autoIncrement": true,
      "channel": "internal-test",
      "environment": "production",
      "ios": {
        "channel": "getitonline-organization"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "ios": {
        "channel": "getitonline-organization"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "organization-ios": {
      "extends": "production",
      "distribution": "store",
      "channel": "getitonline-organization",
      "ios": {
        "scheme": "Gettitonline",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6816962475",
        "appleTeamId": "5THHD5US74"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "organization-ios": {
      "extends": "production"
    }
  }
}
